{
  "name": "piuma-editor",
  "version": "2.0.0",
  "description": "Piuma · Editor Markdown Professionale & Distraction-Free",
  "main": "main.js",
  "author": "Piuma Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:dir": "electron-builder --dir",
    "tauri": "tauri",
    "tauri:dev": "node scripts/prepare_web.js && tauri dev",
    "tauri:build": "node scripts/prepare_web.js && tauri build"
  },
  "build": {
    "appId": "com.piuma.editor",
    "productName": "Piuma Markdown Editor",
    "copyright": "Copyright © 2026 Piuma Team",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "protocols": {
      "name": "piuma-protocol",
      "schemes": [
        "piuma"
      ]
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
