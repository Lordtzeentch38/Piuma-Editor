{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Piuma",
  "version": "2.0.0",
  "identifier": "com.piuma.editor",
  "build": {
    "frontendDist": "../src_web"
  },
  "app": {
    "windows": [
      {
        "title": "Piuma Pro \u00b7 Markdown Editor",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}